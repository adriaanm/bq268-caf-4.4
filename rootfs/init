#!/bin/sh
# Minimal init for CAF 4.4 — diagnose sleep hang, then USB serial
#
# Dumps diagnostics to fbcon (tty0) before testing sleep.
# The tiny screen shows the last ~8 lines, so output is minimal.

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
mount -t tmpfs tmpfs /tmp
mount -t configfs configfs /sys/kernel/config

# Mount rootfs partition for firmware files
mkdir -p /mnt/rootfs
mount -o ro /dev/mmcblk0p36 /mnt/rootfs 2>/dev/null
if [ -d /mnt/rootfs/lib/firmware ]; then
    ln -s /mnt/rootfs/lib/firmware /lib/firmware
fi

hostname bq268-caf

CON=/dev/tty0
GREEN=/sys/class/leds/green/brightness
RED=/sys/class/leds/red/brightness

# Green on, red off = init reached
echo 255 > $GREEN 2>/dev/null
echo 0   > $RED   2>/dev/null

# Dump timer diagnostics to screen
# Clear screen — show timer IRQs then test sleep
echo -e "\033[2J\033[H" > $CON
grep arch_timer /proc/interrupts > $CON
sleep 1
echo "SLEEP OK" > $CON

# If we get here, sleep works — red/green blink to confirm
i=0
while [ $i -lt 2 ]; do
    echo 0   > $GREEN 2>/dev/null
    echo 255 > $RED   2>/dev/null
    sleep 1
    echo 255 > $GREEN 2>/dev/null
    echo 0   > $RED   2>/dev/null
    sleep 1
    i=$((i + 1))
done

# USB ACM gadget via configfs
GADGET=/sys/kernel/config/usb_gadget/g1

mkdir -p $GADGET
echo 0x1d6b > $GADGET/idVendor
echo 0x0104 > $GADGET/idProduct
mkdir -p $GADGET/strings/0x409
echo "BQ268"       > $GADGET/strings/0x409/product
echo "bq268-caf44" > $GADGET/strings/0x409/serialnumber
echo "Anthropic"   > $GADGET/strings/0x409/manufacturer

mkdir -p $GADGET/configs/c.1/strings/0x409
echo "ACM Serial" > $GADGET/configs/c.1/strings/0x409/configuration
echo 500          > $GADGET/configs/c.1/MaxPower

mkdir -p $GADGET/functions/acm.usb0
ln -s $GADGET/functions/acm.usb0 $GADGET/configs/c.1/

UDC=$(ls /sys/class/udc/ 2>/dev/null | head -1)
if [ -n "$UDC" ]; then
    echo "$UDC" > $GADGET/UDC
    echo "Gadget bound: $UDC" > $CON
fi

# Wait for ttyGS0 using busywait instead of sleep
i=0
while [ ! -e /dev/ttyGS0 ] && [ $i -lt 50 ]; do
    # ~0.2s busy wait per iteration, 50 iterations = ~10s
    j=0; while [ $j -lt 2000000 ]; do j=$((j+1)); done
    i=$((i + 1))
done

if [ -e /dev/ttyGS0 ]; then
    echo 0 > $RED 2>/dev/null
    echo "ttyGS0 ready" > $CON
    {
        echo ""
        echo "========================================"
        echo " CAF 4.4 minimal Linux — BQ268"
        echo " $(uname -r) / $(uname -m)"
        echo "========================================"
        echo ""
    } > /dev/ttyGS0
    export ENV=/etc/profile
    # Respawn shell forever so quitting screen doesn't kill console
    while true; do
        setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1'
        sleep 1
    done &
else
    echo "no ttyGS0" > $CON
    # Blink green with busywait
    while true; do
        echo 0 > $GREEN 2>/dev/null
        j=0; while [ $j -lt 5000000 ]; do j=$((j+1)); done
        echo 255 > $GREEN 2>/dev/null
        j=0; while [ $j -lt 5000000 ]; do j=$((j+1)); done
    done
fi

# Trigger modem/ADSP firmware load via PIL (after USB serial is up)
if [ -f /sys/kernel/boot_adsp/boot ]; then
    echo "PIL: triggering modem firmware load..." > $CON
    echo 1 > /sys/kernel/boot_adsp/boot
    echo "PIL: modem load triggered" > $CON
fi

# Keep init alive
while true; do
    sleep 3600
done
