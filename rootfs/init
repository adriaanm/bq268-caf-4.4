#!/bin/sh
# Minimal init for CAF 4.4 — test sleep, then USB serial console
#
# Boot sequence (watch LEDs):
#   1. Green on, red off       = init reached, mounts done
#   2. Red/green alternating   = sleep works! (3 cycles)
#   3. Green solid             = USB gadget configured, waiting for ttyGS0
#   4. Red off, green solid    = shell on ttyGS0 ready
#
# Failure modes:
#   - Stuck at step 1 (green on, red off) = sleep hangs
#   - Green blink after step 3            = ttyGS0 never appeared

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
mount -t tmpfs tmpfs /tmp
mount -t configfs configfs /sys/kernel/config

hostname bq268-caf

GREEN=/sys/class/leds/green/brightness
RED=/sys/class/leds/red/brightness

# Step 1: init reached — green on, red off
echo 255 > $GREEN 2>/dev/null
echo 0   > $RED   2>/dev/null

# Step 2: test sleep with red/green alternating blink (3 cycles)
# If sleep hangs, we'll be stuck with green on + red off (step 1).
i=0
while [ $i -lt 3 ]; do
    sleep 1
    echo 0   > $GREEN 2>/dev/null
    echo 255 > $RED   2>/dev/null
    sleep 1
    echo 255 > $GREEN 2>/dev/null
    echo 0   > $RED   2>/dev/null
    i=$((i + 1))
done

# Step 3: sleep works — set up USB ACM gadget via configfs
GADGET=/sys/kernel/config/usb_gadget/g1

mkdir -p $GADGET
echo 0x1d6b > $GADGET/idVendor   # Linux Foundation
echo 0x0104 > $GADGET/idProduct  # Multifunction Composite Gadget
mkdir -p $GADGET/strings/0x409
echo "BQ268"       > $GADGET/strings/0x409/product
echo "bq268-caf44" > $GADGET/strings/0x409/serialnumber
echo "Anthropic"   > $GADGET/strings/0x409/manufacturer

mkdir -p $GADGET/configs/c.1/strings/0x409
echo "ACM Serial" > $GADGET/configs/c.1/strings/0x409/configuration
echo 500          > $GADGET/configs/c.1/MaxPower

mkdir -p $GADGET/functions/acm.usb0
ln -s $GADGET/functions/acm.usb0 $GADGET/configs/c.1/

# Bind to UDC
UDC=$(ls /sys/class/udc/ 2>/dev/null | head -1)
if [ -n "$UDC" ]; then
    echo "$UDC" > $GADGET/UDC
fi

# Wait for ttyGS0
i=0
while [ ! -e /dev/ttyGS0 ] && [ $i -lt 10 ]; do
    sleep 1
    i=$((i + 1))
done

if [ -e /dev/ttyGS0 ]; then
    # Step 4: USB serial ready — red off, green solid
    echo 0 > $RED 2>/dev/null
    {
        echo ""
        echo "========================================"
        echo " CAF 4.4 minimal Linux — BQ268"
        echo " $(uname -r) / $(uname -m)"
        echo "========================================"
        echo ""
    } > /dev/ttyGS0
    export ENV=/etc/profile
    setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1' &
else
    # Blink green = ttyGS0 failed
    while true; do
        echo 0   > $GREEN 2>/dev/null; sleep 1
        echo 255 > $GREEN 2>/dev/null; sleep 1
    done
fi

# Keep init alive
while true; do
    sleep 3600
done
