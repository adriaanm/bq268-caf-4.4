# MSM8909 BQ268 defconfig for CAF 4.4
# Phase 1: minimal boot — serial console, clocks, pinctrl
CONFIG_LOCALVERSION="-bq268"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_AUDIT=y
CONFIG_NO_HZ=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_LOG_BUF_SHIFT=16
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_NAMESPACES=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_KALLSYMS_ALL=y
CONFIG_EMBEDDED=y
CONFIG_PROFILING=y
CONFIG_ARCH_MMAP_RND_BITS=16
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_PARTITION_ADVANCED=y

# Platform
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_MSM8909=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_PREEMPT=y
CONFIG_AEABI=y
CONFIG_HIGHMEM=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=8
CONFIG_SECCOMP=y
CONFIG_AUTO_ZRELADDR=y
CONFIG_CPU_IDLE=y
CONFIG_VFP=y
CONFIG_NEON=y

# Console / early debug
CONFIG_EARLY_IOREMAP=y
CONFIG_EARLY_PRINTK=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_PMSG=y

# Power management
CONFIG_PM_AUTOSLEEP=y
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_WAKELOCKS_LIMIT=0

# Clock framework (legacy CAF — NOT mainline COMMON_CLK)
# CONFIG_COMMON_CLK is not set
CONFIG_COMMON_CLK_MSM=y

# Pinctrl
CONFIG_PINCTRL=y
CONFIG_PINCTRL_MSM8909=y
CONFIG_GPIO_SYSFS=y

# Serial console
CONFIG_SERIAL_MSM_SMD=y

# Networking (minimal, WiFi/WCNSS disabled for bring-up)
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
# CONFIG_WLAN is not set
# CONFIG_WCNSS_CORE is not set

# Block devices / eMMC
CONFIG_MMC=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# Filesystem (rootfs on p36)
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# USB gadget (configfs ACM for serial console)
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_VBUS_DRAW=500
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_MSM_OTG=y
CONFIG_EXTCON=y

# Regulator
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_RPM_SMD=y
CONFIG_REGULATOR_SPM=y

# SPMI (PMIC)
CONFIG_MSM_SPMI=y
CONFIG_MSM_SPMI_PMIC_ARB=y
CONFIG_MSM_QPNP_INT=y
CONFIG_QPNP_POWER_ON=y
CONFIG_QPNP_REVID=y
CONFIG_GPIO_QPNP_PIN=y

# Power
CONFIG_POWER_SUPPLY=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_MSM=y

# SoC infrastructure
CONFIG_MSM_SMEM=y
CONFIG_MSM_SMD=y
CONFIG_MSM_SMD_DEBUG=y
CONFIG_MSM_SMEM_LOGGING=y
CONFIG_MSM_SMP2P=y
CONFIG_MSM_SPM=y
CONFIG_MSM_L2_SPM=y
CONFIG_MSM_SCM=y
CONFIG_MSM_MPM_OF=y
CONFIG_MSM_WATCHDOG_V2=y
CONFIG_MSM_MEMORY_DUMP_V2=y
CONFIG_MSM_BOOT_STATS=y
CONFIG_MSM_COMMON_LOG=y
CONFIG_REMOTE_SPINLOCK_MSM=y

# IPC disabled for bring-up
# CONFIG_IPC_ROUTER is not set

# ION
CONFIG_ION=y
CONFIG_ION_MSM=y

# DMA
CONFIG_DMADEVICES=y
CONFIG_QCOM_SPS_DMA=y
CONFIG_SPS=y
CONFIG_SPS_SUPPORT_NDP_BAM=y

# I2C / SPI
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MSM_V2=y
CONFIG_SPI=y
CONFIG_SPI_QUP=y

# Misc input
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
# CONFIG_INPUT_MOUSE is not set

# Console on display (Phase 3, pre-enable)
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_FONTS=y
CONFIG_FONT_6x11=y
CONFIG_FB=y
CONFIG_FB_SYS_FILLRECT=y
CONFIG_FB_SYS_COPYAREA=y
CONFIG_FB_SYS_IMAGEBLIT=y
CONFIG_FB_SYS_FOPS=y
CONFIG_FB_DEFERRED_IO=y

# fbtft display
CONFIG_STAGING=y
CONFIG_ANDROID=y
CONFIG_FB_TFT=y
CONFIG_FB_TFT_ST7735R=y

# Thermal
CONFIG_THERMAL=y
CONFIG_THERMAL_TSENS8974=y
CONFIG_SENSORS_QPNP_ADC_VOLTAGE=y

# PIL/SSR disabled for bring-up
# CONFIG_MSM_SUBSYSTEM_RESTART is not set
# CONFIG_MSM_PIL is not set

# Audio disabled for bring-up
# Audio
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MSM8909=y

# Debug
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_INFO=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_IPC_LOGGING=y
CONFIG_DEVMEM=y

# IOMMU
CONFIG_MSM_IOMMU_V1=y

# Bus scaling — disabled to bisect boot regression
# CONFIG_QCOM_BUS_SCALING is not set
# CONFIG_QCOM_BIMC_BWMON is not set
# CONFIG_DEVFREQ_GOV_QCOM_BW_HWMON is not set
# CONFIG_QCOM_DEVFREQ_DEVBW is not set

# Reset / SCM / IRQ migration
CONFIG_RESET_CONTROLLER=y
CONFIG_POWER_RESET_QCOM=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_QPNP_POWER_ON=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_DLOAD_MODE=y
CONFIG_GENERIC_IRQ_MIGRATION=y

# Security (minimal)
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
# CONFIG_SECURITY_SELINUX is not set

# Crypto
CONFIG_CRYPTO_NULL=y
CONFIG_CRYPTO_SHA512=y

# Compression for zram
CONFIG_ZRAM=y

# Firmware loader (no fallback — avoids 60s timeouts)
# CONFIG_FW_LOADER_USER_HELPER_FALLBACK is not set

# Subsystem restart + PIL (needed for WCNSS, modem)
CONFIG_MSM_SUBSYSTEM_RESTART=y
CONFIG_MSM_PIL=y
CONFIG_MSM_PIL_SSR_GENERIC=y

# WCNSS / WiFi
CONFIG_WCNSS_CORE=y
CONFIG_WCNSS_CORE_PRONTO=y
CONFIG_WCNSS_REGISTER_DUMP_ON_BITE=y
CONFIG_WCNSS_MEM_PRE_ALLOC=y
CONFIG_CNSS=y
CONFIG_CNSS_CRYPTO=y
CONFIG_WLAN=y
CONFIG_PRONTO_WLAN=m

# WiFi networking prereqs
CONFIG_NETDEVICES=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y

# DIAG disabled for bring-up
# CONFIG_DIAG_CHAR is not set

# RTC
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_QPNP=y

# LEDs
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y

# Switch
CONFIG_SWITCH=y

# HW random
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_MSM_LEGACY=y
